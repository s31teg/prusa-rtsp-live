# Copy to .env (plain Docker) or enter these in Portainer's stack
# "Environment variables". Only PRUSA_TOKEN and CAMERA_URL are required.

# webcam (live view, token from "Add new camera") or buddy3d (token from "Add new other camera")
MODE=webcam
PRUSA_TOKEN=
CAMERA_URL=rtsps://192.168.1.10:7441/STREAMKEY?enableSrtp

# Optional
CAMERA_NAME=Printer cam
# FINGERPRINT=          # only when reusing a token another device already used
SNAPSHOT_INTERVAL=10
VIDEO_MAX_WIDTH=1920
VIDEO_MAX_HEIGHT=1080
VIDEO_MAX_FPS=25
